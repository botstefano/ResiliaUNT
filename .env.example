# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# SOLO servidor: Supabase service_role. Nunca usar NEXT_PUBLIC_ ni enviarla al navegador.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# URL base de la aplicación. Obligatoria para invitaciones desde /portal/admin.
# En Render reemplazar por el dominio HTTPS del servicio.
NEXT_PUBLIC_APP_URL=http://localhost:3000

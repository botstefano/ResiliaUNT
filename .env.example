# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# SOLO servidor: Supabase Settings > API Keys > Secret keys (sb_secret_...).
# Nunca usar NEXT_PUBLIC_ ni enviar esta clave al navegador.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Compatibilidad legacy (solo si aún utilizas la antigua service_role JWT):
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# URL base de la aplicación. Obligatoria para invitaciones desde /portal/admin.
# En Render reemplazar por el dominio HTTPS del servicio.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de demostración (solo registros sintéticos).
DEMO_MODE_ENABLED=false
# Secreto aleatorio de servidor, sin prefijo NEXT_PUBLIC_.
DEMO_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Groq — solo servidor. Nunca uses NEXT_PUBLIC_ con las claves.
# La clave/modelo general son el fallback para ambos chatbots.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=YOUR_GROQ_MODEL_ID
# Overrides opcionales por rol:
# GROQ_API_KEY_THERAPIST=YOUR_THERAPIST_GROQ_API_KEY
# GROQ_MODEL_THERAPIST=YOUR_THERAPIST_MODEL_ID
# GROQ_API_KEY_STUDENT=YOUR_STUDENT_GROQ_API_KEY
# GROQ_MODEL_STUDENT=YOUR_STUDENT_MODEL_ID
# Opcional; por defecto https://api.groq.com/openai/v1
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
